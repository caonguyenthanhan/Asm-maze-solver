{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Assemble maze solver",
      "type": "process",
      "command": "C:\\msys64\\mingw32\\bin\\nasm.exe",
      "args": [
        "-f",
        "win32",
        "main.asm",
        "-o",
        "main.o"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\mingw32\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build maze solver",
      "type": "process",
      "command": "C:\\msys64\\mingw32\\bin\\gcc.exe",
      "args": [
        "-m32",
        "main.o",
        "-o",
        "maze_solver.exe",
        "-lkernel32"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "C:\\msys64\\mingw32\\bin;${env:PATH}"
        }
      },
      "dependsOn": "Assemble maze solver",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Run maze solver",
      "type": "process",
      "command": "${workspaceFolder}\\maze_solver.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "Build maze solver",
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Assemble UI demo",
      "type": "process",
      "command": "C:\\msys64\\mingw32\\bin\\nasm.exe",
      "args": [
        "-f",
        "win32",
        "demo_ui.asm",
        "-o",
        "demo_ui.o"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\UI",
        "env": {
          "PATH": "C:\\msys64\\mingw32\\bin;${env:PATH}"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "Build UI demo",
      "type": "process",
      "command": "C:\\msys64\\mingw32\\bin\\gcc.exe",
      "args": [
        "-m32",
        "demo_ui.o",
        "-o",
        "ui_demo.exe",
        "-lkernel32"
      ],
      "options": {
        "cwd": "${workspaceFolder}\\UI",
        "env": {
          "PATH": "C:\\msys64\\mingw32\\bin;${env:PATH}"
        }
      },
      "dependsOn": "Assemble UI demo",
      "dependsOrder": "sequence",
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Build and run UI demo",
      "type": "process",
      "command": "${workspaceFolder}\\UI\\ui_demo.exe",
      "options": {
        "cwd": "${workspaceFolder}\\UI"
      },
      "dependsOn": "Build UI demo",
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
